{
  "name": "dayline",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/build-service-worker.mjs && tsup server/index.ts --format esm --platform node --target node24 --out-dir build --external @electric-sql/pglite",
    "start": "node --env-file-if-exists=.env build/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:watch": "tsx --test --watch tests/*.test.ts",
    "test:one": "tsx --test",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && tsx --test tests/*.test.ts",
    "preview": "concurrently -k \"node build/index.js\" \"vite preview --host 127.0.0.1 --port 5173 --strictPort\"",
    "preview:test": "node scripts/preview-test.mjs",
    "e2e": "node scripts/browser-check.mjs && node scripts/verify-browser.mjs",
    "e2e:quick": "node scripts/browser-check.mjs && node scripts/verify-browser.mjs --quick"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.8",
    "@hocuspocus/server": "4.8.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-mathematics": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-task-item": "3.32.2",
    "@tiptap/extension-task-list": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/y-tiptap": "3.0.12",
    "fastify": "5.12.8",
    "katex": "0.18.10",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@hocuspocus/provider": "4.8.0",
    "@playwright/test": "1.64.1",
    "@tiptap/extension-collaboration": "3.32.2",
    "@tiptap/extension-drag-handle": "3.32.2",
    "@tiptap/extension-drag-handle-react": "3.32.2",
    "@tiptap/extension-file-handler": "3.32.2",
    "@tiptap/extension-node-range": "3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "idb": "8.0.4",
    "lucide-react": "1.66.0",
    "mermaid": "12.2.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "y-indexeddb": "9.0.12"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
