# Configuration for `docker compose up -d`. Local development (`npm run dev`) needs no .env.
# Copy to .env and fill in the empty values. See docs/self-hosting.md.

# Public address people open in the browser. Invitation and password-reset links use it.
APP_ORIGIN=http://localhost
# What Caddy listens on: your domain (dayline.example.com) for automatic HTTPS, or :80 for plain HTTP.
DAYLINE_ADDRESS=:80

# Password for the bundled PostgreSQL. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# One-time code the installation wizard asks for, so nobody else can install before you.
# Generate with: openssl rand -hex 24
SETUP_TOKEN=
# 32-byte hex key that encrypts two-step verification secrets and AI provider keys.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Without docker compose, run `npm run build && npm start` and point to your own PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dayline
# HOST=0.0.0.0
# PORT=4310
# COLLABORATION_PORT=4311
# TRUSTED_PROXY_IP=<exact IP of your reverse proxy>
